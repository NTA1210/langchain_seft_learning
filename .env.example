# Provider selection: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini

# Gemini Developer API
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ollama
OLLAMA_MODEL=qwen3:8b

# LangSmith (optional at first, recommended from agent module onward)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-advanced-learning
